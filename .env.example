# URL base del backend en Go. Déjala vacía para usar el mismo origen (proxy de Vite en desarrollo
# o el reverse proxy que sirva la web en producción).
VITE_API_BASE_URL=

# A dónde reenvía Vite las llamadas /v1 durante el desarrollo.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Maps JavaScript API (restricción: sitios web). Solo en .env local, nunca en Git.
VITE_GOOGLE_MAPS_KEY=
